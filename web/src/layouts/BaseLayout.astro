---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={site.name} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') {
						document.documentElement.setAttribute('data-theme', stored);
					}
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<canvas class="bg-dots" aria-hidden="true"></canvas>
		<slot />
		<script>
			import { initBgDotWaves } from '../scripts/bg-dot-waves';

			const reveals = document.querySelectorAll('.reveal');
			if (reveals.length && 'IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
				);
				reveals.forEach((el) => observer.observe(el));
			} else {
				reveals.forEach((el) => el.classList.add('is-visible'));
			}

			const frames = Array.from(
				document.querySelectorAll<HTMLElement>('.frame'),
			);
			const heroSection = document.querySelector<HTMLElement>('.hero.section');
			const footerSection = document.querySelector<HTMLElement>('.footer.section');
			const header = document.querySelector<HTMLElement>('.header');

			function getDotGridPx() {
				const probe = document.createElement('div');
				probe.style.cssText =
					'position:absolute;visibility:hidden;width:var(--dot-grid);height:var(--dot-grid)';
				document.body.appendChild(probe);
				const size = probe.getBoundingClientRect().width;
				probe.remove();
				return size || 18;
			}

			function snapFramesToGrid() {
				const grid = getDotGridPx();

				for (const frame of frames) {
					frame.style.removeProperty('--snap-x');
					frame.style.removeProperty('--snap-y');
					frame.style.removeProperty('width');
					frame.style.removeProperty('min-height');
				}

				void document.body.offsetHeight;

				for (const frame of frames) {
					const rect = frame.getBoundingClientRect();
					const absLeft = rect.left + window.scrollX;
					const absTop = rect.top + window.scrollY;
					const snappedLeft = Math.round(absLeft / grid) * grid;
					const snappedTop = Math.round(absTop / grid) * grid;
					const snappedWidth = Math.max(grid, Math.round(rect.width / grid) * grid);
					const snappedHeight = Math.max(
						grid,
						Math.ceil(rect.height / grid) * grid,
					);

					frame.style.setProperty('--snap-x', `${snappedLeft - absLeft}px`);
					frame.style.setProperty('--snap-y', `${snappedTop - absTop}px`);
					frame.style.width = `${snappedWidth}px`;
					frame.style.minHeight = `${snappedHeight}px`;
				}
			}

			function snapToGrid(value: number, grid: number) {
				return Math.max(0, Math.round(value / grid) * grid);
			}

			function updateEdgePads() {
				if (!heroSection || !footerSection) return;

				const grid = getDotGridPx();
				const viewportH = window.innerHeight;
				const headerH = header?.getBoundingClientRect().height ?? 0;
				const heroH = heroSection.getBoundingClientRect().height;
				const footerH = footerSection.getBoundingClientRect().height;

				const startPad = snapToGrid(
					viewportH / 2 - headerH - heroH / 2,
					grid,
				);
				const endPad = snapToGrid(viewportH / 2 - footerH / 2, grid);

				document.documentElement.style.setProperty(
					'--edge-pad-start',
					`${startPad}px`,
				);
				document.documentElement.style.setProperty(
					'--edge-pad-end',
					`${endPad}px`,
				);
			}

			function updateActiveFrame() {
				if (!frames.length) return;

				const viewportCenter = window.innerHeight / 2;
				let closest: HTMLElement | null = null;
				let closestDistance = Infinity;

				for (const frame of frames) {
					const rect = frame.getBoundingClientRect();
					const inView = rect.bottom > 0 && rect.top < window.innerHeight;
					if (!inView) continue;

					const frameCenter = rect.top + rect.height / 2;
					const distance = Math.abs(frameCenter - viewportCenter);
					if (distance < closestDistance) {
						closestDistance = distance;
						closest = frame;
					}
				}

				for (const frame of frames) {
					frame.classList.toggle('is-active', frame === closest);
				}
			}

			let rafId = 0;
			function onScroll() {
				cancelAnimationFrame(rafId);
				rafId = requestAnimationFrame(updateActiveFrame);
			}

			function onResize() {
				cancelAnimationFrame(rafId);
				rafId = requestAnimationFrame(() => {
					snapFramesToGrid();
					updateEdgePads();
					updateActiveFrame();
				});
			}

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onResize);
			window.addEventListener('load', onResize);
			document.fonts?.ready.then(onResize);
			onResize();

			if (heroSection && footerSection && 'ResizeObserver' in window) {
				const edgePadObserver = new ResizeObserver(() => onResize());
				edgePadObserver.observe(heroSection);
				edgePadObserver.observe(footerSection);
			}

			const bgDots = document.querySelector<HTMLCanvasElement>('.bg-dots');
			if (bgDots) {
				initBgDotWaves(bgDots, getDotGridPx);
			}
		</script>
	</body>
</html>
