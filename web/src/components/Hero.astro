---
import { site } from '../data/site';
---

<section class="hero section" aria-labelledby="hero-name">
	<div class="container frame">
		<span class="frame__mark frame__mark--tl" aria-hidden="true"></span>
		<span class="frame__mark frame__mark--br" aria-hidden="true"></span>
		<div class="reveal">
			<p class="hero__eyebrow">Software developer</p>
			<h1 id="hero-name" class="hero__name">{site.name}</h1>
			<p class="hero__bio">{site.bio}</p>
		</div>
	</div>
</section>

<style>
	.hero__eyebrow {
		margin-bottom: var(--dot-grid);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: var(--dot-grid);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.hero__name {
		font-size: var(--text-3xl);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.125;
		margin-bottom: var(--space-5);
	}

	.hero__bio {
		max-width: 34rem;
		font-size: var(--text-lg);
		line-height: var(--space-5);
		color: var(--color-text-muted);
	}
</style>
