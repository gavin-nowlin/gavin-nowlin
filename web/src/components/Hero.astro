---
import { site } from '../data/site';
---

<section class="hero section" aria-labelledby="hero-name">
	<div class="container frame">
		<div class="reveal">
			<p class="hero__eyebrow">Software developer</p>
			<h1 id="hero-name" class="hero__name">{site.name}</h1>
			<p class="hero__bio">{site.bio}</p>
		</div>
	</div>
</section>

<style>
	.hero__eyebrow {
		margin-bottom: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: var(--dot-grid);
		text-transform: uppercase;
		color: var(--color-text-muted);
		filter: drop-shadow(0 0 0 transparent);
		transition:
			color 0.5s var(--ease-out),
			filter 0.5s var(--ease-out);
	}

	.frame.is-active .hero__eyebrow {
		color: var(--color-accent);
		filter: drop-shadow(0 0 0.35rem var(--color-glow))
			drop-shadow(0 0 0.75rem color-mix(in oklch, var(--color-accent) 45%, transparent));
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__eyebrow {
			transition: none;
		}
	}

	.hero__name {
		font-size: var(--text-3xl);
		font-weight: 700;
		line-height: 1.125;
		margin-bottom: var(--space-6);
	}

	.hero__bio {
		max-width: 34rem;
		font-size: var(--text-lg);
		line-height: var(--space-5);
		color: var(--color-text-muted);
	}
</style>
